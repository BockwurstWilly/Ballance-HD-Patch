// Minimal <initializer_list> (layout as the compiler expects it).
#pragma once
#include <stddef.h>
namespace std {
template <class E> class initializer_list {
    const E *b; size_t n;
    constexpr initializer_list(const E *p, size_t s) noexcept : b(p), n(s) {}
public:
    typedef E value_type; typedef const E &reference; typedef const E &const_reference; typedef size_t size_type;
    typedef const E *iterator; typedef const E *const_iterator;
    constexpr initializer_list() noexcept : b(0), n(0) {}
    constexpr size_t size() const noexcept { return n; }
    constexpr const E *begin() const noexcept { return b; }
    constexpr const E *end() const noexcept { return b + n; }
};
template <class E> constexpr const E *begin(initializer_list<E> l) noexcept { return l.begin(); }
template <class E> constexpr const E *end(initializer_list<E> l) noexcept { return l.end(); }
}
